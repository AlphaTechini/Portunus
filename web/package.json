{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"compile:contract": "tsx scripts/compile-contract.ts",
		"setup:tempo": "tsx scripts/setup-tempo.ts",
		"check:scripts": "tsc -p scripts/tsconfig.json",
		"test": "vitest run",
		"test:tempo": "vitest run -c vitest.tempo.config.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ethereumjs/common": "^10.1.3",
		"@ethereumjs/evm": "^10.1.3",
		"@ethereumjs/util": "^10.1.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"solc": "0.8.28",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/ui": "./src/lib/ui/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/newsreader": "^5.3.0",
		"@lucide/svelte": "^1.55.0",
		"convex": "^1.46.0",
		"convex-svelte": "^0.14.0",
		"ox": "^0.14.54",
		"viem": "^2.57.4"
	}
}
